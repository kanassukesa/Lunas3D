# =============================================================================
# Lunas 3D — variáveis de ambiente
# -----------------------------------------------------------------------------
# 1. Copie este arquivo para ".env.local" (na mesma pasta).
#    Windows (PowerShell):  Copy-Item .env.example .env.local
# 2. Preencha os valores. O .env.local NUNCA vai para o Git (está no .gitignore).
# 3. Reinicie o "npm run dev" sempre que mudar este arquivo.
#
# Regra de ouro: variáveis que começam com NEXT_PUBLIC_ ficam visíveis no
# navegador. Nunca coloque segredo numa variável NEXT_PUBLIC_.
# =============================================================================

# Endereço do site. Local: http://localhost:3000 — na Vercel: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase  (painel do projeto → Project Settings → API Keys / Data API)
# -----------------------------------------------------------------------------
# URL do projeto, ex.: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA ("Publishable key", começa com sb_publishable_...).
# Projetos antigos: pode usar a "anon key" (eyJ...) em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA ("Secret key", começa com sb_secret_...). IGNORA o RLS!
# Usada só no servidor. Projetos antigos: "service_role key" em SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Resend — e-mails (Etapa 6). https://resend.com → API Keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Remetente. Sem domínio verificado, use: Lunas 3D <onboarding@resend.dev>
EMAIL_FROM="Lunas 3D <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Melhor Envio — frete (Etapa 3)
# Sandbox: https://sandbox.melhorenvio.com.br → Configurações → Permissões de acesso → Tokens
# -----------------------------------------------------------------------------
MELHOR_ENVIO_TOKEN=
# "sandbox" no desenvolvimento, "production" quando for ao ar
MELHOR_ENVIO_ENV=sandbox
# E-mail de contato exigido pelo Melhor Envio no cabeçalho User-Agent
MELHOR_ENVIO_USER_AGENT_EMAIL=
